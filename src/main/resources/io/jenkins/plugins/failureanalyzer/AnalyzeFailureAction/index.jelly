<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
    <l:layout title="Smart Analysis - ${it.run.fullDisplayName}">
        <st:include page="sidepanel.jelly" it="${it.run}" />
        <l:main-panel>

            <style>
                .sa-wrap {
                    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                    color: #1f2933;
                    background: #f8fafc;
                    border: 1px solid #e2e8f0;
                    border-radius: 12px;
                    padding: 24px;
                    max-width: 100%;
                }
                .sa-hero {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    border-bottom: 2px solid #e2e8f0;
                    padding-bottom: 16px;
                    margin-bottom: 24px;
                }
                .sa-title {
                    margin: 0;
                    font-size: 24px;
                    font-weight: 700;
                    color: #0f172a;
                }
                /* Loading and Timeline State */
                .sa-loader-container {
                    background: white;
                    border-radius: 12px;
                    padding: 32px 40px;
                    margin-bottom: 24px;
                    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
                }
                .sa-timeline {
                    position: relative;
                    padding-left: 32px;
                    margin: 10px 0;
                }
                .sa-timeline::before {
                    content: '';
                    position: absolute;
                    left: 11px;
                    top: 8px;
                    bottom: 8px;
                    width: 2px;
                    background: #e2e8f0;
                }
                .sa-timeline-item {
                    position: relative;
                    margin-bottom: 24px;
                }
                .sa-timeline-item:last-child {
                    margin-bottom: 0;
                }
                .sa-timeline-marker {
                    position: absolute;
                    left: -32px;
                    top: 0;
                    width: 24px;
                    height: 24px;
                    border-radius: 50%;
                    background: white;
                    border: 2px solid #cbd5e1;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    z-index: 1;
                    transition: all 0.3s ease;
                }
                .sa-timeline-item.active .sa-timeline-marker {
                    border-color: #6366f1;
                    background: #e0e7ff;
                }
                .sa-timeline-item.active .sa-timeline-marker::after {
                    content: '';
                    width: 8px;
                    height: 8px;
                    border-radius: 50%;
                    background: #6366f1;
                    animation: sa-pulse-dot 1.5s infinite ease-in-out;
                }
                .sa-timeline-item.done .sa-timeline-marker {
                    border-color: #10b981;
                    background: #10b981;
                }
                .sa-timeline-item.done .sa-timeline-marker::after {
                    content: '✓';
                    color: white;
                    font-size: 14px;
                    font-weight: bold;
                }
                .sa-timeline-item.failed .sa-timeline-marker {
                    border-color: #ef4444;
                    background: #ef4444;
                }
                .sa-timeline-item.failed .sa-timeline-marker::after {
                    content: '✗';
                    color: white;
                    font-size: 14px;
                    font-weight: bold;
                }
                @keyframes sa-pulse-dot {
                    0% { transform: scale(0.8); opacity: 0.5; }
                    50% { transform: scale(1.2); opacity: 1; }
                    100% { transform: scale(0.8); opacity: 0.5; }
                }
                .sa-timeline-content {
                    color: #64748b;
                    font-size: 15px;
                    font-weight: 500;
                    padding-top: 2px;
                    transition: color 0.3s;
                }
                .sa-timeline-item.active .sa-timeline-content {
                    color: #4f46e5;
                    font-weight: 600;
                }
                .sa-timeline-item.done .sa-timeline-content {
                    color: #10b981;
                }
                .sa-timeline-item.failed .sa-timeline-content {
                    color: #ef4444;
                    font-weight: 600;
                }
                
                /* Results State */
                .sa-results {
                    display: none;
                }
                .sa-card {
                    background: white;
                    border-radius: 6px;
                    padding: 20px;
                    margin-bottom: 20px;
                    border: 1px solid #e2e8f0;
                    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
                }
                .sa-ai-analysis {
                    border-left: 4px solid #0056b3;
                    background: #f8fafc;
                }
                .sa-ai-title {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    color: #0f172a;
                    margin-top: 0;
                    margin-bottom: 12px;
                    font-size: 18px;
                    font-weight: 600;
                }
                .sa-analysis-content {
                    font-size: 14px;
                    line-height: 1.5;
                    color: #334155;
                    /* removed white-space: pre-wrap because markdown generates HTML tags */
                }
                .sa-stage-row {
                    display: flex;
                    flex-direction: column;
                    margin-bottom: 16px;
                    padding-bottom: 16px;
                    border-bottom: 1px solid #e2e8f0;
                }
                .sa-stage-row:last-child {
                    border-bottom: none;
                    margin-bottom: 0;
                    padding-bottom: 0;
                }
                .sa-stage-header {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    margin-bottom: 8px;
                }
                .sa-stage-name {
                    font-weight: 600;
                    font-size: 16px;
                    color: #1e293b;
                }
                .sa-status-PASSED { color: #16a34a; background: #dcfce7; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; }
                .sa-status-FAILED { color: #dc2626; background: #fee2e2; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; }
                .sa-log-box {
                    background: #f8fafc;
                    color: #0f172a;
                    border: 1px solid #e2e8f0;
                    padding: 16px;
                    border-radius: 8px;
                    font-family: monospace;
                    font-size: 13px;
                    overflow-x: auto;
                    max-height: 400px;
                    white-space: pre-wrap;
                    word-wrap: break-word;
                }
            </style>

            <st:bind var="itProxy" value="${it}" />
            <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
            <div class="sa-wrap">
                <div class="sa-hero">
                    <div>
                        <div style="font-size:13px; color:#64748b; font-weight:600; text-transform:uppercase; letter-spacing:1px; margin-bottom:4px;">Smart Insights Analysis</div>
                        <h1 class="sa-title">Build: ${it.run.fullDisplayName}</h1>
                    </div>
                </div>

                <div id="sa-loader" class="sa-loader-container">
                    <h3 style="margin-top:0; color:#0f172a; margin-bottom:16px;">Analyzing Failure</h3>
                    <div class="sa-timeline">
                        <div id="step-1" class="sa-timeline-item active">
                            <div class="sa-timeline-marker"></div>
                            <div class="sa-timeline-content">Extracting Logs</div>
                        </div>
                        <div id="step-2" class="sa-timeline-item">
                            <div class="sa-timeline-marker"></div>
                            <div class="sa-timeline-content">Parsing Context</div>
                        </div>
                        <div id="step-3" class="sa-timeline-item">
                            <div class="sa-timeline-marker"></div>
                            <div class="sa-timeline-content">Analyzing Pattern with AI...</div>
                        </div>
                    </div>
                </div>

                <div id="sa-results" class="sa-results">
                    <div class="sa-card sa-ai-analysis">
                        <h2 class="sa-ai-title">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                            AI Root Cause Analysis
                        </h2>
                        <div id="sa-analysis-text" class="sa-analysis-content markdown-body"></div>
                    </div>

                    <div class="sa-card">
                        <h3 style="margin-top:0; margin-bottom:20px; color:#0f172a;">Build Execution Context</h3>
                        <div id="sa-stages-container"></div>
                    </div>
                </div>
            </div>

            <style>
                .markdown-body h1, .markdown-body h2, .markdown-body h3, .markdown-body h4 { color: #0f172a; font-weight: 600; margin: 16px 0 8px 0; padding: 0; }
                .markdown-body h3 { font-size: 15px; }
                .markdown-body h4 { font-size: 14px; }
                .markdown-body p { margin: 0 0 12px 0; }
                .markdown-body ul, .markdown-body ol { margin: 0 0 12px 0; padding-left: 20px; }
                .markdown-body li { margin-bottom: 4px; }
                .markdown-body strong { font-weight: 600; color: #0f172a; }
                .markdown-body code { background: #f1f5f9; padding: 2px 4px; border-radius: 4px; font-size: 13px; font-family: monospace; }
                .markdown-body pre { margin: 8px 0; }
                .markdown-body pre code { display: block; padding: 12px; background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a; overflow-x: auto; font-size: 12px; }
            </style>

            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    // Update steps progressively for UI feedback
                    setTimeout(function() {
                        document.getElementById('step-1').className = 'sa-timeline-item done';
                        document.getElementById('step-2').className = 'sa-timeline-item active';
                        
                        setTimeout(function() {
                            document.getElementById('step-2').className = 'sa-timeline-item done';
                            document.getElementById('step-3').className = 'sa-timeline-item active';
                        }, 1000); // give the user time to read
                    }, 800);

                    // Call backend via Stapler js proxy
                    itProxy.doAnalyzeAjax(function(response) {
                        try {
                            if (response.status !== 200) {
                                throw new Error('Analysis request failed with status ' + response.status);
                            }
                            var rawData = response.responseObject();
                            var data = JSON.parse(rawData);

                            if (data.errorMessage &amp;&amp; !data.stages) {
                                throw new Error(data.errorMessage);
                            }

                            // Complete UI progress
                            document.getElementById('step-3').className = 'sa-step done';

                            setTimeout(function() {
                                // Hide loader, show results
                                document.getElementById('sa-loader').style.display = 'none';
                                document.getElementById('sa-results').style.display = 'block';

                                // Render Markdown
                                var aiRaw = data.aiAnalysis || 'No analysis available.';
                                if (typeof marked !== 'undefined') {
                                    document.getElementById('sa-analysis-text').innerHTML = marked.parse(aiRaw);
                                } else {
                                    document.getElementById('sa-analysis-text').innerText = aiRaw;
                                }

                                // Build stages HTML manually to avoid Jelly template string injection bugs
                                var stagesContainer = document.getElementById('sa-stages-container');
                                stagesContainer.innerHTML = '';

                                if (data.stages &amp;&amp; data.stages.length > 0) {
                                    var tl = document.createElement('div');
                                    tl.className = 'sa-timeline';
                                    
                                    data.stages.forEach(function(stage) {
                                        var isFailed = stage.failed;
                                        
                                        var item = document.createElement('div');
                                        item.className = 'sa-timeline-item ' + (isFailed ? 'failed' : 'done');

                                        var marker = document.createElement('div');
                                        marker.className = 'sa-timeline-marker';
                                        item.appendChild(marker);

                                        var content = document.createElement('div');
                                        content.className = 'sa-timeline-content';
                                        
                                        var header = document.createElement('div');
                                        header.className = 'sa-stage-header';
                                        
                                        var nameSpan = document.createElement('span');
                                        nameSpan.className = 'sa-stage-name';
                                        nameSpan.innerText = stage.stageName;

                                        header.appendChild(nameSpan);
                                        content.appendChild(header);

                                        var logContent = stage.stageLog;
                                        if (logContent &amp;&amp; logContent.trim().length > 0 &amp;&amp; logContent.indexOf('reduce context size') === -1) {
                                            var logBox = document.createElement('div');
                                            logBox.className = 'sa-log-box';
                                            logBox.style.marginTop = '12px';
                                            logBox.innerText = logContent;
                                            content.appendChild(logBox);
                                        }

                                        item.appendChild(content);
                                        tl.appendChild(item);
                                    });
                                    stagesContainer.appendChild(tl);
                                } else {
                                    stagesContainer.innerHTML = '<div style="color:#64748b;">No stage context available</div>';
                                }
                            }, 500); // extra wait for smooth transition

                        } catch(error) {
                            document.getElementById('sa-loader').style.display = 'none';
                            document.getElementById('sa-results').style.display = 'block';
                            var errDiv = document.createElement('div');
                            errDiv.style.color = '#dc2626';
                            errDiv.style.fontWeight = 'bold';
                            errDiv.innerText = 'Error analyzing build: ' + error.message;
                            document.getElementById('sa-analysis-text').appendChild(errDiv);
                        }
                    });
                });
            </script>
        </l:main-panel>
    </l:layout>
</j:jelly>
