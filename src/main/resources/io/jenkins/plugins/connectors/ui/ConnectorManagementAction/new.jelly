<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:f="/lib/form">
    <l:layout title="Create New Connector">
        <l:side-panel>
            <l:tasks>
                <l:task icon="symbol-arrow-left" href="." title="Back to Dashboard" />
            </l:tasks>
        </l:side-panel>
        <l:main-panel>
            <style>
                .page-transition {
                    animation: fadeIn 0.4s ease-in-out;
                }
                @keyframes fadeIn {
                    from { opacity: 0; transform: translateY(10px); }
                    to { opacity: 1; transform: translateY(0); }
                }
                .field-err { color: #c00; font-size: 12px; margin-top: 4px; display: none; }
                input.input-error, .jenkins-input.input-error { border-color: #c00 !important; box-shadow: 0 0 0 2px rgba(204,0,0,0.15) !important; }

                /* Required-fields banner */
                #conn-required-banner {
                    display: none;
                    align-items: center;
                    gap: 10px;
                    background: #fff8e1;
                    border: 1px solid #ffe082;
                    border-radius: 6px;
                    padding: 10px 16px;
                    margin-bottom: 16px;
                    font-size: 13px;
                    color: #6d4c00;
                }
                #conn-required-banner.visible { display: flex; }

                /* Disabled submit style */
                #conn-submit-btn:disabled,
                #conn-submit-btn[disabled] {
                    opacity: 0.45;
                    cursor: not-allowed;
                    pointer-events: none;
                }
            </style>

            <div class="page-transition">
                <h1>Create New Connector</h1>
                <p>Fill in the required fields below to create a new connector.</p>

                <!-- Required-fields warning banner (shown instead of calling backend) -->
                <div id="conn-required-banner">
                    <span style="font-size:18px;">⚠</span>
                    <span id="conn-required-banner-msg">Please fill in all required fields before saving.</span>
                </div>

                <f:form action="create" method="post" name="config" id="create-connector-form"
                        onsubmit="return connCreateValidate(event)">

                    <f:entry title="Connector ID*" field="id"
                             description="Required. Alphanumeric, hyphens, underscores only. No spaces. e.g. my-github-connector">
                        <f:textbox id="conn-id-input"
                                   oninput="connValidateId(this)" />
                        <div class="field-err" id="conn-id-error"></div>
                    </f:entry>

                    <f:entry title="Description" field="description">
                        <f:textbox />
                    </f:entry>

                    <f:dropdownDescriptorSelector field="connector" title="Connector Category"
                                                  descriptors="${it.connectorDescriptors}" />

                    <f:block>
                        <!--
                            The submit button is kept as a regular button and we handle validation
                            in JS — disabled state is managed dynamically.
                        -->
                        <button type="submit" id="conn-submit-btn"
                                class="jenkins-button jenkins-button--primary"
                                disabled="disabled">
                            ✔ Create Connector
                        </button>
                        <a href="." class="jenkins-button" style="margin-left:10px;">Cancel</a>
                    </f:block>
                </f:form>

                <script>
                    var connSubmitBtn = document.getElementById('conn-submit-btn');

                    function connValidateId(input) {
                        var val = input ? input.value : '';
                        var errEl = document.getElementById('conn-id-error');
                        var msg = '';
                        if (!val.trim()) {
                            msg = '⚠ Connector ID is required.';
                        } else if (/\s/.test(val)) {
                            msg = '⚠ ID must not contain spaces.';
                        } else if (!/^[\w\-\.]+$/.test(val)) {
                            msg = '⚠ ID may only contain letters, digits, hyphens, underscores, or dots.';
                        }
                        if (errEl) {
                            errEl.textContent = msg;
                            errEl.style.display = msg ? 'block' : 'none';
                        }
                        if (input) {
                            input.classList.toggle('input-error', !!msg);
                        }
                        // Enable/disable submit button
                        if (connSubmitBtn) {
                            var valid = !msg &amp;&amp; val.trim().length > 0;
                            connSubmitBtn.disabled = !valid;
                        }
                        return !msg;
                    }

                    function connShowBanner(msg) {
                        var banner = document.getElementById('conn-required-banner');
                        var bannerMsg = document.getElementById('conn-required-banner-msg');
                        if (bannerMsg) bannerMsg.textContent = msg;
                        if (banner) banner.classList.add('visible');
                        // Auto-hide after 4s
                        setTimeout(function() { if (banner) banner.classList.remove('visible'); }, 4000);
                    }

                    function connCreateValidate(e) {
                        var idInput = document.getElementById('conn-id-input');
                        if (!idInput) return true; // let server validate

                        var idOk = connValidateId(idInput);
                        if (!idOk) {
                            if (e) e.preventDefault();
                            connShowBanner('⚠ Please fill in all required fields before saving. Connector ID is required.');
                            return false;
                        }
                        return true;
                    }

                    // Wire the form's submit event (onsubmit attr handles it too, this is a safety net)
                    (function() {
                        var form = document.getElementById('create-connector-form');
                        if (form) {
                            form.addEventListener('submit', function(e) {
                                if (!connCreateValidate(e)) {
                                    e.preventDefault();
                                    return false;
                                }
                            });
                        }
                    })();
                </script>
            </div>
        </l:main-panel>
    </l:layout>
</j:jelly>
