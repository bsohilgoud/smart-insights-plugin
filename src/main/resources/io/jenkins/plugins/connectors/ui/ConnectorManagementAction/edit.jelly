<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:f="/lib/form">
    <l:layout title="Edit Connector">
        <l:side-panel>
            <l:tasks>
                <l:task icon="symbol-arrow-left" href="." title="Back to Dashboard" />
            </l:tasks>
        </l:side-panel>
        <l:main-panel>
            <style>
                .page-transition {
                    animation: fadeIn 0.4s ease-in-out;
                }
                @keyframes fadeIn {
                    from { opacity: 0; transform: translateY(10px); }
                    to { opacity: 1; transform: translateY(0); }
                }
            </style>

            <div class="page-transition">
                <!--
                    Jenkins Jelly binding: 'instance' is used by f:form and sub-forms to pre-populate fields.
                    We set it here so that each f:textbox picks up existing connector values automatically.
                    The descriptor's config.jelly reads ${instance.fieldName} to render pre-filled inputs.
                -->
                <j:set var="instance" value="${it.getConnector(request.getParameter('id'))}" />
                <j:if test="${instance == null}">
                    <div style="padding:20px; color:#c00;">
                        Error: Connector with ID "${request.getParameter('id')}" was not found.
                        <a href=".">Back to Dashboard</a>
                    </div>
                </j:if>
                <j:if test="${instance != null}">
                    <h1>Edit Connector</h1>
                    <p>Modify settings for <strong>${instance.name}</strong> <code>(${instance.id})</code>.</p>

                    <!--
                        action="update" → Stapler routes to doUpdate().
                        id is passed as a hidden hidden field so doUpdate can look up and replace the connector.
                    -->
                    <f:form action="update" method="post" name="config" id="edit-connector-form">

                        <!-- Hidden field carries the immutable ID so doUpdate knows which connector to replace -->
                        <input type="hidden" name="id" value="${instance.id}" />

                        <f:entry title="Connector ID" description="Unique string identifier (read-only — cannot be changed).">
                            <input type="text" value="${instance.id}" readonly="readonly"
                                   class="jenkins-input" style="background:#f5f5f5; cursor:not-allowed;" />
                        </f:entry>

                        <f:entry title="Name" field="name" description="Human-readable display name.">
                            <f:textbox value="${instance.name}" />
                        </f:entry>

                        <f:entry title="Description" field="description">
                            <f:textbox value="${instance.description}" />
                        </f:entry>

                        <!--
                            f:dropdownDescriptorSelector will render the selected descriptor's config.jelly.
                            Setting 'instance' above means those sub-forms will have access to
                            ${instance.scmEngine}, ${instance.repoUrl}, etc. for pre-population.
                        -->
                        <f:dropdownDescriptorSelector
                            field="connector"
                            title="Connector Type"
                            descriptors="${it.connectorDescriptors}" />

                        <f:block>
                            <f:submit value="Update Connector" />
                        </f:block>
                    </f:form>
                </j:if>
            </div>
        </l:main-panel>
    </l:layout>
</j:jelly>
