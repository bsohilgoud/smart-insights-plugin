<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:f="/lib/form">
    <l:layout title="Edit Connector">
        <l:side-panel>
            <l:tasks>
                <l:task icon="symbol-arrow-left" href="." title="Back to Dashboard" />
            </l:tasks>
        </l:side-panel>
        <l:main-panel>
            <style>
                .page-transition { animation: fadeIn 0.35s ease-in-out; }
                @keyframes fadeIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
                .info-badge {
                    display: inline-flex; align-items: center; gap: 8px;
                    background: #f0f7ff; border: 1px solid #c6e0f5;
                    border-radius: 6px; padding: 9px 14px; margin-bottom: 18px;
                    font-size: 13px; color: #2d5a8e;
                }
                .field-error {
                    color: #c00; font-size: 12px; margin-top: 3px; display: none;
                }
                .jenkins-input[aria-invalid="true"] { border-color: #c00 !important; }
            </style>

            <div class="page-transition">
                <!--
                    Retrieve the existing connector from storage.
                    IMPORTANT: setting 'instance' as Jelly var makes sub-forms (ScmConnector/config.jelly)
                    automatically read ${instance.repoUrl}, ${instance.scmEngine} etc. for pre-population.
                -->
                <j:set var="instance" value="${it.getConnector(request.getParameter('id'))}" />

                <j:if test="${instance == null}">
                    <div style="padding:16px; background:#fff3f3; border:1px solid #f5c6c6; border-radius:6px; color:#c00;">
                        ⚠ Connector <code>${request.getParameter('id')}</code> not found —
                        it may have been deleted. <a href=".">← Back</a>
                    </div>
                </j:if>

                <j:if test="${instance != null}">
                    <h1>Edit Connector</h1>

                    <div class="info-badge">
                        💾 Editing <strong>${instance.descriptor.displayName}</strong>:
                        <strong>${instance.name}</strong>
                        <code style="background:#e0eeff; padding:2px 6px; border-radius:3px; margin-left:4px;">${instance.id}</code>
                    </div>

                    <!--
                        action="update" → Stapler routes this to doUpdate().
                        The ID is passed as a hidden input so doUpdate can look up
                        the existing connector and replace it.
                    -->
                    <f:form action="update" method="post" name="config" id="edit-connector-form">

                        <!-- Immutable ID passed as hidden field -->
                        <input type="hidden" name="id" value="${instance.id}" />

                        <f:entry title="Connector ID"
                                 description="Unique identifier — cannot be changed after creation.">
                            <input type="text" value="${instance.id}" readonly="readonly"
                                   class="jenkins-input"
                                   style="background:#f4f4f4; cursor:not-allowed; color:#555;" />
                        </f:entry>

                        <f:entry title="Name" field="name" description="Human-readable display name.">
                            <f:textbox value="${instance.name}" />
                        </f:entry>

                        <f:entry title="Description" field="description">
                            <f:textbox value="${instance.description}" />
                        </f:entry>

                        <!--
                            f:dropdownDescriptorSelector renders all connector type tabs.
                            We use JavaScript (below) to auto-select the correct type after render,
                            since there is no native 'default' pre-selection mechanism.
                            The 'instance' variable being set ensures each sub-form reads existing
                            values via ${instance.repoUrl} etc.
                        -->
                        <f:dropdownDescriptorSelector
                            field="connector"
                            title="Connector Type"
                            descriptors="${it.connectorDescriptors}" />

                        <f:block>
                            <f:submit value="💾 Update Connector" />
                            <a href="." class="jenkins-button" style="margin-left:10px;">Cancel</a>
                        </f:block>
                    </f:form>

                    <script>
                        // Auto-select the correct connector type in the dropdown after page render.
                        // f:dropdownDescriptorSelector has no native 'pre-select' support — we
                        // drive the selection via JavaScript by matching the descriptor displayName.
                        (function() {
                            var targetTypeName = '${instance.descriptor.displayName}';

                            function selectCorrectType() {
                                // The descriptor selector renders a <select> with one option per type
                                var selects = document.querySelectorAll('select');
                                for (var i = 0; i &lt; selects.length; i++) {
                                    var sel = selects[i];
                                    for (var j = 0; j &lt; sel.options.length; j++) {
                                        if (sel.options[j].text.trim() === targetTypeName.trim()) {
                                            if (sel.selectedIndex !== j) {
                                                sel.selectedIndex = j;
                                                // Trigger Jenkins' own change handler to show the right sub-form
                                                sel.dispatchEvent(new Event('change', { bubbles: true }));
                                            }
                                            return true;
                                        }
                                    }
                                }
                                return false;
                            }

                            // Try immediately, then retry after a tick (Jenkins may render asynchronously)
                            if (!selectCorrectType()) {
                                setTimeout(selectCorrectType, 100);
                                setTimeout(selectCorrectType, 400);
                            }
                        })();
                    </script>
                </j:if>
            </div>
        </l:main-panel>
    </l:layout>
</j:jelly>
