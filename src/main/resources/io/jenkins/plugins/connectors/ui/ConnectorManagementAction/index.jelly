<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:f="/lib/form">
    <l:layout title="Connectors Dashboard">
        <l:side-panel>
            <l:tasks>
                <l:task icon="symbol-arrow-up" href="${rootURL}/" title="Back to Jenkins" />
                <l:task icon="symbol-add" href="new" title="Add New Connector" permission="${it.class.name.contains('Global') ? app.ADMINISTER : null}" />
            </l:tasks>
        </l:side-panel>
        <l:main-panel>
            <style>
                /* Icon-action buttons */
                .action-btn {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    width: 32px;
                    height: 32px;
                    border-radius: 6px;
                    border: 1px solid transparent;
                    cursor: pointer;
                    transition: background 0.18s, border-color 0.18s, box-shadow 0.18s;
                    background: none;
                    text-decoration: none;
                    vertical-align: middle;
                    padding: 0;
                }
                .action-btn svg {
                    width: 16px;
                    height: 16px;
                    display: block;
                }
                .action-btn.edit-btn {
                    color: #1565c0;
                    border-color: #bbdefb;
                }
                .action-btn.edit-btn:hover {
                    background: #e3f2fd;
                    border-color: #1565c0;
                    box-shadow: 0 1px 4px rgba(21,101,192,0.18);
                }
                .action-btn.delete-btn {
                    color: #c62828;
                    border-color: #ffcdd2;
                }
                .action-btn.delete-btn:hover {
                    background: #ffebee;
                    border-color: #c62828;
                    box-shadow: 0 1px 4px rgba(198,40,40,0.18);
                }
                .action-cell {
                    display: flex;
                    align-items: center;
                    gap: 6px;
                }
                /* Inline delete form must not add extra margin */
                .action-cell form {
                    margin: 0;
                    padding: 0;
                    display: inline-flex;
                }
                .toast-notification {
                    visibility: hidden;
                    min-width: 250px;
                    background-color: #4CAF50;
                    color: #fff;
                    text-align: center;
                    border-radius: 4px;
                    padding: 16px;
                    position: fixed;
                    z-index: 1000;
                    right: 30px;
                    top: 30px;
                    font-size: 14px;
                }
                .toast-notification.show {
                    visibility: visible;
                    animation: fadein 0.5s, fadeout 0.5s 2.5s;
                }
                @keyframes fadein {
                    from {top: 0; opacity: 0;}
                    to {top: 30px; opacity: 1;}
                }
                @keyframes fadeout {
                    from {top: 30px; opacity: 1;}
                    to {top: 0; opacity: 0;}
                }
            </style>

            <div id="toast" class="toast-notification">Action completed successfully</div>

            <script>
                function showToast(message) {
                    var toast = document.getElementById("toast");
                    if (message) toast.innerText = message;
                    toast.className = "toast-notification show";
                    setTimeout(function(){ toast.className = toast.className.replace("show", ""); }, 3000);
                }

                // Show toast if URL param indicates success
                if (window.location.search.indexOf('created=true') > -1) {
                    showToast('✓ Connector created successfully!');
                } else if (window.location.search.indexOf('deleted=true') > -1) {
                    showToast('✓ Connector deleted successfully!');
                } else if (window.location.search.indexOf('updated=true') > -1) {
                    showToast('✓ Connector updated successfully!');
                }
            </script>

            <h1>Connectors Dashboard</h1>
            <p>Manage all external connections scoped to your folders and pipelines.</p>

            <div style="display:inline-flex; align-items:center; gap:8px; background:#f0f7ff; border:1px solid #c6e0f5;
                        border-radius:6px; padding:8px 14px; margin-bottom:16px; font-size:13px; color:#2d5a8e;">
                <span style="font-size:16px;">💾</span>
                <span>
                    Storage scope: <strong>
                        <j:if test="${it.folder}">📁 ${it.scopeLabel}</j:if>
                        <j:if test="${!it.folder}">🌐 ${it.scopeLabel}</j:if>
                    </strong>
                </span>
            </div>

            <!--
                jenkins-table is the native Jenkins modern table class — picks up
                the same rounded, bordered, zebra-stripe styling used in Credentials,
                Manage Plugins, etc.
            -->
            <table class="jenkins-table">
                <thead>
                    <tr>
                        <th class="jenkins-table__cell--tight"></th>
                        <th>ID</th>
                        <th>Description</th>
                        <th>Type</th>
                        <th class="jenkins-table__cell--tight">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <j:forEach var="c" items="${it.connectors}">
                        <tr>
                            <td class="jenkins-table__cell--tight">
                                <l:icon class="${c.descriptor.iconClassName} icon-sm" />
                            </td>
                            <td><code>${c.id}</code></td>
                            <td>${c.description}</td>
                            <td>${c.descriptor.displayName}</td>
                            <td>
                                <div class="action-cell">
                                    <!-- Edit: pencil SVG icon button -->
                                    <a href="edit?id=${c.id}" class="action-btn edit-btn" title="Edit connector">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                        </svg>
                                    </a>
                                    <!-- Delete: trash SVG icon button -->
                                    <f:form action="delete?id=${c.id}" method="post" style="display:inline-flex; margin:0;">
                                        <button type="submit" class="action-btn delete-btn" title="Delete connector"
                                                onclick="return confirm('Delete connector ${c.id}? This cannot be undone.')">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <polyline points="3 6 5 6 21 6" />
                                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                                <path d="M10 11v6" />
                                                <path d="M14 11v6" />
                                                <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                                            </svg>
                                        </button>
                                    </f:form>
                                </div>
                            </td>
                        </tr>
                    </j:forEach>
                    <j:if test="${empty it.connectors}">
                        <tr>
                            <td colspan="5" style="text-align:center; padding: 30px;">
                                <div style="color:#666;">No connectors found in this scope.</div>
                                <a href="new" class="jenkins-button jenkins-button--primary" style="margin-top:10px;">Create your first Connector</a>
                            </td>
                        </tr>
                    </j:if>
                </tbody>
            </table>
        </l:main-panel>
    </l:layout>
</j:jelly>
